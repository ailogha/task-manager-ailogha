# ============================================================================
# AI Provider (optional)
# ============================================================================
# GEMINI_API_KEY: Required only if using the built-in Gemini AI assistant.
# Users configure this via the Secrets panel in AI Studio, or directly here.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ============================================================================
# Application
# ============================================================================
# APP_URL: The public URL where the app is hosted (used for self-referential
# links, OAuth callbacks, API endpoints).
APP_URL="https://taskmanager.ailogha.com"

# ============================================================================
# Database
# ============================================================================
# Database URL resolution priority:
#   1. libsql://...  → remote Turso/libSQL (managed production option)
#   2. file:...      → explicit local file path
#   3. unset         → automatic local default
#                        - Production (NODE_ENV=production or /app/data exists):
#                            /app/data/sqlite.db  ← Coolify persistent volume
#                        - Development: ./sqlite.db (repo root)
#
# To use Turso/libSQL instead of the local file, set BOTH:
# DATABASE_URL="libsql://your-db.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-token"
#
# To override the local file path explicitly:
# DATABASE_URL="file:/app/data/sqlite.db"

# ============================================================================
# First-run admin seeding (optional but recommended for production)
# ============================================================================
# On a fresh database (no users), these env vars auto-create the first admin.
# Without them, you must use the /setup page manually on first launch.
ADMIN_EMAIL="admin@ailogha.com"
ADMIN_PASSWORD="ChangeMe_StrongPassword!"
ADMIN_NAME="المدير العام"
